{
  "name": "GetBible MCP",
  "registry_name": "net.getbible/mcp",
  "mcp_server_version": "2.0.1",
  "status": "stable",
  "endpoint_note": "The official public MCP endpoint is https://mcp.getbible.net/. Use the exact root URL; select upstream API versions with tool arguments.",
  "transports": {
    "streamable_http": {
      "url": "https://mcp.getbible.net/",
      "custom_endpoints_supported": true
    },
    "stdio": {
      "command": "getbible-mcp",
      "args": [
        "--transport",
        "stdio"
      ],
      "installation": "#local-installation"
    }
  },
  "capabilities": {
    "tools": true,
    "resources": true,
    "prompts": true
  },
  "tools": "tool-catalog.json",
  "resources": [
    "getbible://docs/api",
    "getbible://docs/cache-policy",
    "getbible://docs/usage-policy",
    "getbible://openapi/api/v2",
    "getbible://openapi/api/v3",
    "getbible://openapi/query/v2",
    "getbible://openapi/query/v3",
    "getbible://openapi/search/v2",
    "getbible://openapi/search/v3",
    "getbible://openapi/dictionaries/v1",
    "getbible://openapi/commentaries/v1",
    "getbible://openapi/bookmarks/v1"
  ],
  "prompts": [
    "design_getbible_integration"
  ],
  "apis": [
    {
      "service": "api",
      "api_version": "v2",
      "openapi": "https://api.getbible.net/v2/openapi.json",
      "snapshot": "../contracts/api-v2.json"
    },
    {
      "service": "api",
      "api_version": "v3",
      "openapi": "https://api.getbible.net/v3/openapi.json",
      "snapshot": "../contracts/api-v3.json"
    },
    {
      "service": "query",
      "api_version": "v2",
      "openapi": "https://query.getbible.net/v2/openapi.json",
      "snapshot": "../contracts/query-v2.json"
    },
    {
      "service": "query",
      "api_version": "v3",
      "openapi": "https://query.getbible.net/v3/openapi.json",
      "snapshot": "../contracts/query-v3.json"
    },
    {
      "service": "search",
      "api_version": "v2",
      "openapi": "https://search.getbible.net/v2/openapi.json",
      "snapshot": "../contracts/search-v2.json"
    },
    {
      "service": "search",
      "api_version": "v3",
      "openapi": "https://search.getbible.net/v3/openapi.json",
      "snapshot": "../contracts/search-v3.json"
    },
    {
      "service": "dictionaries",
      "api_version": "v1",
      "openapi": "https://dictionaries.getbible.net/v1/openapi.json",
      "snapshot": "../contracts/dictionaries-v1.json"
    },
    {
      "service": "commentaries",
      "api_version": "v1",
      "openapi": "https://commentaries.getbible.net/v1/openapi.json",
      "snapshot": "../contracts/commentaries-v1.json"
    },
    {
      "service": "bookmarks",
      "api_version": "v1",
      "openapi": "https://bookmarks.getbible.net/v1/openapi.json",
      "snapshot": "../contracts/bookmarks-v1.json"
    }
  ],
  "documentation": {
    "ai": "llms.txt",
    "api": "api.md",
    "usage_policy": "usage-policy.md",
    "cache_policy": "cache-policy.md",
    "examples": "examples.md"
  },
  "cache": {
    "maximum_retention_seconds": 2592000,
    "honor_shorter_http_freshness": true,
    "query_search_mcp_cache": false
  },
  "access": {
    "public": true,
    "free": true,
    "account_required": false,
    "token_required_by_default": false,
    "anonymous_rate_limits": true,
    "rate_limit_policy": "usage-policy.md",
    "optional_tokens": {
      "request": "Contact GetBible administrators for a token for MCP or any API endpoint.",
      "header": "Authorization",
      "scheme": "Bearer",
      "secure_client_configuration": true
    },
    "retry": {
      "status": 429,
      "honor_retry_after": true,
      "backoff": true
    }
  },
  "documentation_version": "2.0"
}
