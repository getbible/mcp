{
  "name": "GetBible MCP",
  "package_version": "2.1.1",
  "description": "Read-only Model Context Protocol access to scripture, query and search v2/v3, plus dictionaries, commentaries and bookmarks v1.",
  "website": "https://getBible.net",
  "documentation": "https://getBible.net/mcp",
  "documentation_note": "The v2 directory documents MCP package 2.x and every supported upstream API version.",
  "manifest": "v2/manifest.json",
  "transports": {
    "streamable_http": {
      "url": "https://mcp.getbible.net/",
      "custom_endpoints_supported": true
    },
    "stdio": {
      "command": "getbible-mcp",
      "args": [
        "--transport",
        "stdio"
      ]
    }
  },
  "upstream_versions": {
    "api": [
      "v2",
      "v3"
    ],
    "query": [
      "v2",
      "v3"
    ],
    "search": [
      "v2",
      "v3"
    ],
    "dictionaries": [
      "v1"
    ],
    "commentaries": [
      "v1"
    ],
    "bookmarks": [
      "v1"
    ]
  },
  "default_scripture_version": "v3",
  "usage_policy": "v2/usage-policy.md"
}
